# OS-generated
.DS_Store

# Scratch notebooks (archived 2026-08-02)
archive/Thesis_code.ipynb
archive/test codes/

# Output ------------------------------------------------------------------
# figures/ and tables/ ARE tracked — they are paper deliverables and small.
# data/ holds solved models and simulation dumps, which can be very large.
output/data/
output/reports/*.aux
output/reports/*.log

# Docs: LaTeX sources/builds and the paper library are kept locally only.
docs/latex/
docs/papers/

# Julia
*.jl.cov
*.jl.mem
_nb_smoketest.jl

# Legacy SMM output from the retired 14-parameter estimator (now
# archive/smm_14param_legacy.jl). Not regenerable and not read by anything.
output/data/smm_estimates.toml

# output/identification/ and output/sensitivity/ ARE tracked: they are the saved
# Jacobians, standard errors and sensitivity curves the review asked to be reproducible
# artefacts rather than recollections. They are small text and CSV.

# Input: the Stata moment files are TRACKED (instruction 2026-09-06) so that a fresh
# clone -- the server in particular -- can regenerate the by-age CSVs without a separate
# file transfer. ~6.3 MB in total. The generated targets file is tracked too, because
# run_smm.jl needs it and must not require Stata.
#
# NOTE: this repository is PUBLIC, and these are PSID/CDS microdata --
# SMM_Moments_Micro.dta is individual-level (16,043 rows). Check the redistribution terms
# of the data agreement before pushing them. Git history is permanent: deleting a file in
# a later commit does not remove it from history, from existing clones, or from forks.
temp/
output/tables/
output/figures/

# Server-local: agent config and per-clone Julia depot
.claude/
.julia_depot/

# Server-local MCP config
.mcp.json

# SMM run outputs: logs, checkpoints and per-run estimates are reproducible artefacts
output/smm_runs/*
# Frozen, reviewed nine-parameter baseline (keep original evidence in clones).
!output/smm_runs/2026-09-06_183119/
!output/smm_runs/2026-09-06_183119/**

# The `latest` symlink run_smm.jl re-points at every run. Per-machine, not shared.
output/smm_runs/latest
temp/latest
